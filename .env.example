# Donde se guardan los assets de cada proyecto.
OUTPUT_DIR=remotion/public/renders

# --- API keys (completa solo las que vayas a usar) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

KIEAI_API_KEY=
APIFY_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# --- Solo para produccion (api.py) ---
# Clave que tiene que mandar la web para poder generar. Si queda vacia, la API
# es publica: no la dejes asi en internet o te vacian los creditos.
APP_TOKEN=
# Dominios desde los que se aceptan pedidos, separados por coma.
ALLOWED_ORIGINS=https://tu-proyecto.vercel.app
# Cuantos videos se pueden generar a la vez.
MAX_CONCURRENT_JOBS=2
